<div>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-rose-500/10 via-transparent to-transparent"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center py-20">
      <h1 class="text-6xl sm:text-7xl md:text-8xl font-extrabold tracking-tight mb-6">
        <span class="bg-gradient-to-r from-rose-400 via-rose-500 to-rose-600 bg-clip-text text-transparent">
          Exclosured
        </span>
      </h1>

      <p class="text-lg sm:text-xl md:text-2xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed">
        Compile Rust to WebAssembly, run it in your users' browsers, talk to it from Phoenix LiveView.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
        <a href="https://hex.pm/packages/exclosured" target="_blank" rel="noopener noreferrer">
          <img src="https://img.shields.io/hexpm/v/exclosured.svg?style=flat-square&color=f43f5e" alt="Hex.pm" class="h-6" />
        </a>
        <a href="https://www.npmjs.com/package/exclosured" target="_blank" rel="noopener noreferrer">
          <img src="https://img.shields.io/npm/v/exclosured.svg?style=flat-square&color=f43f5e" alt="npm" class="h-6" />
        </a>
        <a href="https://crates.io/crates/exclosured_guest" target="_blank" rel="noopener noreferrer">
          <img src="https://img.shields.io/crates/v/exclosured_guest.svg?style=flat-square&color=f43f5e" alt="crates.io" class="h-6" />
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="https://github.com/cocoa-xu/exclosured#readme" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center px-8 py-3.5 bg-rose-500 hover:bg-rose-600 text-white font-semibold rounded-lg transition-all duration-200 shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40">
          Get Started
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="#demos"
          class="inline-flex items-center px-8 py-3.5 border border-slate-700 hover:border-rose-500/50 text-slate-300 hover:text-white font-semibold rounded-lg transition-all duration-200">
          View Demos
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Why Section -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
        Why <span class="text-rose-500">Exclosured</span>?
      </h2>
      <p class="text-slate-400 text-center mb-16 max-w-2xl mx-auto">
        Move compute from your servers to your users' browsers. Keep data private by design.
      </p>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="group bg-slate-900 border border-slate-800 rounded-xl p-8 hover:border-rose-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-rose-500/10 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Zero Server Cost</h3>
          <p class="text-slate-400 leading-relaxed">
            1,000 users = 1,000 browsers doing their own compute. Your server stays idle while users' machines handle the heavy lifting.
          </p>
        </div>

        <div class="group bg-slate-900 border border-slate-800 rounded-xl p-8 hover:border-emerald-400/50 transition-all duration-300">
          <div class="w-12 h-12 bg-emerald-400/10 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Structural Privacy</h3>
          <p class="text-slate-400 leading-relaxed">
            Data lives in WASM linear memory and never reaches your server. Privacy by architecture, not just by policy.
          </p>
        </div>

        <div class="group bg-slate-900 border border-slate-800 rounded-xl p-8 hover:border-sky-400/50 transition-all duration-300">
          <div class="w-12 h-12 bg-sky-400/10 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Local Latency</h3>
          <p class="text-slate-400 leading-relaxed">
            Sub-millisecond response times. No round-trip needed. Compute happens right on the user's device.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Code Preview Section -->
  <section class="py-24 px-6 bg-slate-900/50">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
        Write <span class="text-rose-500">Rust</span>, ship <span class="text-emerald-400">WASM</span>
      </h2>
      <p class="text-slate-400 text-center mb-16 max-w-2xl mx-auto">
        Define WASM functions inline with the <code class="text-rose-400 bg-slate-800 px-2 py-0.5 rounded text-sm">~RUST</code> sigil.
        One line is all it takes. Editor extensions can inject Rust syntax highlighting inside the sigil.
      </p>

      <div class="mb-8">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">One-liner</span>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 overflow-x-auto">
          <pre class="text-sm sm:text-base"><code><%= Phoenix.HTML.raw(ExclosuredAppWeb.LandingHTML.oneliner_code()) %></code></pre>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Multi-line with ~RUST sigil</span>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 overflow-x-auto">
          <pre class="text-sm sm:text-base leading-relaxed"><code><%= Phoenix.HTML.raw(ExclosuredAppWeb.LandingHTML.multiline_code()) %></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Ecosystem Section -->
  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">Ecosystem</h2>
      <p class="text-slate-400 text-center mb-16 max-w-2xl mx-auto">
        A complete toolkit spanning Elixir, JavaScript, and Rust.
      </p>

      <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
        <table class="w-full">
          <thead>
            <tr class="border-b border-slate-800">
              <th class="text-left px-6 py-4 text-sm font-semibold text-slate-300">Package</th>
              <th class="text-left px-6 py-4 text-sm font-semibold text-slate-300">Registry</th>
              <th class="text-left px-6 py-4 text-sm font-semibold text-slate-300 hidden sm:table-cell">Description</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="px-6 py-4"><a href="https://hex.pm/packages/exclosured" target="_blank" class="text-rose-400 hover:text-rose-300 font-medium">exclosured</a></td>
              <td class="px-6 py-4"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-500/10 text-purple-400">Hex</span></td>
              <td class="px-6 py-4 text-slate-400 text-sm hidden sm:table-cell">Core Elixir library</td>
            </tr>
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="px-6 py-4"><a href="https://www.npmjs.com/package/exclosured" target="_blank" class="text-rose-400 hover:text-rose-300 font-medium">exclosured</a></td>
              <td class="px-6 py-4"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500/10 text-red-400">npm</span></td>
              <td class="px-6 py-4 text-slate-400 text-sm hidden sm:table-cell">Browser runtime + LiveView hook</td>
            </tr>
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="px-6 py-4"><a href="https://crates.io/crates/exclosured_guest" target="_blank" class="text-rose-400 hover:text-rose-300 font-medium">exclosured_guest</a></td>
              <td class="px-6 py-4"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-500/10 text-orange-400">crates.io</span></td>
              <td class="px-6 py-4 text-slate-400 text-sm hidden sm:table-cell">Rust guest SDK</td>
            </tr>
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="px-6 py-4"><a href="https://hex.pm/packages/exclosured_precompiled" target="_blank" class="text-rose-400 hover:text-rose-300 font-medium">exclosured_precompiled</a></td>
              <td class="px-6 py-4"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-500/10 text-purple-400">Hex</span></td>
              <td class="px-6 py-4 text-slate-400 text-sm hidden sm:table-cell">Precompiled WASM distribution</td>
            </tr>
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="px-6 py-4">
                <span class="text-slate-500 font-medium">exclosured-rust-sigil</span>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-500/10 text-sky-400">VS Code</span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 ml-1">Coming Soon</span>
              </td>
              <td class="px-6 py-4 text-slate-400 text-sm hidden sm:table-cell">Rust syntax highlighting inside <code class="text-xs bg-slate-800 px-1.5 py-0.5 rounded">~RUST</code> sigils</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Demos Gallery Section -->
  <section id="demos" class="py-24 px-6 bg-slate-900/50">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">Live Demos</h2>
      <p class="text-slate-400 text-center mb-16 max-w-2xl mx-auto">
        See Exclosured in action. Every demo runs real WASM in your browser.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="https://wasm-ai.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-rose-500 hover:border-rose-500/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Text Processing</h3>
          <p class="text-sm text-slate-400">Compute offload, progress events</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">wasm-ai.exclosured.app</div>
        </a>
        <a href="https://canvas-demo.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-emerald-400 hover:border-emerald-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Interactive Canvas</h3>
          <p class="text-sm text-slate-400">60fps rendering, PubSub sync</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">canvas-demo.exclosured.app</div>
        </a>
        <a href="https://sync-demo.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-sky-400 hover:border-sky-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">State Sync</h3>
          <p class="text-sm text-slate-400">Declarative sync, wave visualizer</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">sync-demo.exclosured.app</div>
        </a>
        <a href="https://realtime-sync.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-amber-400 hover:border-amber-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Image Editor</h3>
          <p class="text-sm text-slate-400">Collaborative editing</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">realtime-sync.exclosured.app</div>
        </a>
        <a href="https://racing-game.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-violet-400 hover:border-violet-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Racing Game</h3>
          <p class="text-sm text-slate-400">Multiplayer, server-authoritative</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">racing-game.exclosured.app</div>
        </a>
        <a href="https://offload-compute.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-rose-500 hover:border-rose-500/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Offload Compute</h3>
          <p class="text-sm text-slate-400">Server vs WASM timing</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">offload-compute.exclosured.app</div>
        </a>
        <a href="https://confidential-compute.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-emerald-400 hover:border-emerald-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Confidential Compute</h3>
          <p class="text-sm text-slate-400">PII stays in browser</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">confidential-compute.exclosured.app</div>
        </a>
        <a href="https://latency-compare.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-sky-400 hover:border-sky-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Latency Compare</h3>
          <p class="text-sm text-slate-400">Server vs local WASM</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">latency-compare.exclosured.app</div>
        </a>
        <a href="https://private-analytics.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-amber-400 hover:border-amber-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Private Analytics</h3>
          <p class="text-sm text-slate-400">E2E encrypted analytics</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">private-analytics.exclosured.app</div>
        </a>
        <a href="https://live-vue-wasm.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-violet-400 hover:border-violet-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">LiveVue + WASM</h3>
          <p class="text-sm text-slate-400">Vue.js stats dashboard</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">live-vue-wasm.exclosured.app</div>
        </a>
        <a href="https://live-svelte-wasm.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-rose-500 hover:border-rose-500/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">LiveSvelte + WASM</h3>
          <p class="text-sm text-slate-400">Markdown editor + KaTeX</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">live-svelte-wasm.exclosured.app</div>
        </a>
        <a href="https://brotli-compress.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-emerald-400 hover:border-emerald-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Brotli Compress</h3>
          <p class="text-sm text-slate-400">Brotli vs Gzip benchmark</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">brotli-compress.exclosured.app</div>
        </a>
        <a href="https://matrix-mul.exclosured.app" target="_blank" class="group block bg-slate-900 border border-slate-800 border-l-4 border-l-sky-400 hover:border-sky-400/50 rounded-xl p-6 transition-all duration-300 hover:bg-slate-800/50">
          <h3 class="text-lg font-semibold mb-2 group-hover:text-white transition-colors">Matrix Multiply</h3>
          <p class="text-sm text-slate-400">5-way benchmark: JS, WASM, WebGPU, TF.js, OpenCV</p>
          <div class="mt-4 text-xs text-slate-500 group-hover:text-slate-400 transition-colors">matrix-mul.exclosured.app</div>
        </a>
