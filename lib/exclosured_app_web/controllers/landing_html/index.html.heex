    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-slate-800 py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <span class="text-2xl font-bold bg-gradient-to-r from-rose-400 to-rose-500 bg-clip-text text-transparent">
          Exclosured
        </span>

        <div class="flex flex-wrap items-center justify-center gap-6 text-sm">
          <a href="https://github.com/cocoa-xu/exclosured" target="_blank" class="text-slate-400 hover:text-white transition-colors">GitHub</a>
          <a href="https://hex.pm/packages/exclosured" target="_blank" class="text-slate-400 hover:text-white transition-colors">Hex.pm</a>
          <a href="https://www.npmjs.com/package/exclosured" target="_blank" class="text-slate-400 hover:text-white transition-colors">npm</a>
          <a href="https://crates.io/crates/exclosured_guest" target="_blank" class="text-slate-400 hover:text-white transition-colors">crates.io</a>
        </div>

        <div class="text-sm text-slate-500 text-center md:text-right">
          <p>MIT License</p>
          <p class="mt-1">Built with Phoenix + Exclosured</p>
        </div>
      </div>
    </div>
  </footer>
</div>
