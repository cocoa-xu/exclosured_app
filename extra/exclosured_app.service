[Unit]
Description=Exclosured Landing Page
After=network-online.target
Wants=network-online.target

[Service]
User=exclosured
Group=exclosured
Environment=PATH=/home/cocoa/.nvm/versions/node/v24.14.0/bin:/var/lib/exclosured/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/var/lib/exclosured/app/extra/run.sh
WorkingDirectory=/var/lib/exclosured/app
RestartSec=10
Restart=always

[Install]
WantedBy=multi-user.target
